# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local settings (local only)
.claude/

# Supabase CLI temp files (contains project ref, not secrets but local config)
supabase/.temp/

# Local Excel test / reference files
*.xlsx
~$*.xlsx

# UI reference materials / design docs (local only)
UI参考/
design-system/
アーキリンク・コンクルー資料/

# Customer real data (never commit)
お客様提出見積り/
下請けからの見積書/
見積り内訳書/
見積書参考/
議事録/
